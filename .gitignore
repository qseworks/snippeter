# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Integration sub-projects (Node/TS)
integrations/**/node_modules/
integrations/cli/dist/
integrations/vscode/out/

# Secrets & local environment — never commit these.
# (Publishable/anon Supabase keys are public by design; the danger is the
# service-role key and any local .env that holds it.)
.env
.env.*
!.env.example
*.local
**/.env
**/.env.*
.envrc

# Keys / certificates / credentials
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
**/service-account*.json
**/*credentials*.json
secrets/

# Supabase local stack & secrets
supabase/.branches/
supabase/.temp/
supabase/.env

# Generated localizations. ARBs in lib/l10n are the source of truth; the Dart
# classes are regenerated by `flutter gen-l10n` (runs on `flutter pub get`
# because `generate: true` is set in pubspec.yaml).
/lib/l10n/app_localizations*.dart
/l10n_untranslated.json
