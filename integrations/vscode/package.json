{
  "name": "snippet-manager",
  "displayName": "Snippeter",
  "description": "Browse, insert, and save code snippets from your Snippeter account directly in VS Code.",
  "version": "0.1.0",
  "publisher": "snippet-manager",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0D0E11",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:snippetManager.signIn",
    "onCommand:snippetManager.insertSnippet",
    "onCommand:snippetManager.saveSelection"
  ],
  "contributes": {
    "commands": [
      {
        "command": "snippetManager.signIn",
        "title": "Snippeter: Sign In"
      },
      {
        "command": "snippetManager.insertSnippet",
        "title": "Snippeter: Insert Snippet"
      },
      {
        "command": "snippetManager.saveSelection",
        "title": "Snippeter: Save Selection as Snippet"
      }
    ],
    "configuration": {
      "title": "Snippeter",
      "properties": {
        "snippetManager.supabaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:55321",
          "markdownDescription": "Supabase project URL. Defaults to the local dev stack (`supabase start`). For a hosted project use `https://<your-project-ref>.supabase.co`."
        },
        "snippetManager.supabaseAnonKey": {
          "type": "string",
          "default": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
          "markdownDescription": "Supabase anon / publishable key. Safe to store — all access is gated by Row Level Security. Defaults to the local dev stack's anon key."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0"
  }
}
